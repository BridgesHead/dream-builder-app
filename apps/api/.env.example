PORT=3000
NODE_ENV=development
# Local MongoDB. Use 127.0.0.1, not "localhost" (on this PC localhost can mean ::1, where MongoDB is not listening).
MONGODB_URI=mongodb://127.0.0.1:27017/dream_builder
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Signs access tokens. Keep it secret. Make your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-your-own-long-random-secret
# The frontend address used in email links
APP_URL=http://localhost:5173
# Version of the consent text parents agree to
CONSENT_TEXT_VERSION=2026-11-v1
# Proxies in front of the API (1 behind the AWS load balancer, 0 on your PC)
TRUST_PROXY_HOPS=0

# ---- Background jobs (BE-07) ----
# Redis for the BullMQ job queue. Leave empty on your PC to use the in-memory queue inside
# the API. With Redis running (e.g. docker run -d -p 6379:6379 redis:7), set it and start
# workers with "pnpm worker".
# REDIS_URL=redis://127.0.0.1:6379
# Who makes the text and pictures: "stub" = fake placeholders, "fal" = the real AI (BE-10),
# "gemini" or "cloudflare" = that service for both.
AI_PROVIDER=stub
# Optional: pick the text and the pictures separately (each falls back to AI_PROVIDER).
# The FREE mix for testing on your PC (made-up children only, see below):
# AI_TEXT_PROVIDER=gemini
# AI_IMAGE_PROVIDER=cloudflare
# On a server (NODE_ENV=production) the free services are refused unless this is "true": test
# servers with made-up children only, never the live site.
# ALLOW_FREE_AI=false
STUB_DELAY_MS=400
QUEUE_CONCURRENCY=4
# fal.ai calls started per second, shared by all workers
AI_CALLS_PER_SECOND=10
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
TEXT_JOB_TIMEOUT_MS=60000
IMAGE_JOB_TIMEOUT_MS=120000

# ---- fal.ai (BE-10) ----
# Your fal.ai key (needed when AI_PROVIDER=fal). Secret: .env or the AWS secret store only.
# FAL_KEY=
# FAL_BASE_URL=https://fal.run
# FAL_TEXT_ENDPOINT=fal-ai/any-llm
# The PRD's Gemini Flash 1.5 is retired; Sami Bhai confirms the replacement.
# FAL_TEXT_MODEL=google/gemini-2.5-flash
# FAL_IMAGE_MODEL=fal-ai/flux/dev
# FAL_CALL_TIMEOUT_MS=50000

# ---- Free AI for testing: Gemini (text) + Cloudflare Workers AI (pictures) ----
# FREE TIERS ARE FOR MADE-UP TEST CHILDREN ONLY: on free plans the service may use what we
# send. The live app uses a paid provider (Sami Bhai decides). Keys: .env only, never in chat.
#
# Gemini: aistudio.google.com → "Get API key". Text is free; Gemini PICTURES are paid.
# GEMINI_API_KEY=
# gemini-2.5-flash allows only ~20 free requests a day (one story uses ~18). For testing,
# gemini-3.5-flash-lite worked well (tested 2026-11-25):
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_CALL_TIMEOUT_MS=50000
#
# Cloudflare: dash.cloudflare.com → your Account ID (account home page), and
# My Profile → API Tokens → Create token → "Workers AI" template. Free daily allowance.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_TEXT_MAX_TOKENS=4096
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# 1–8: more steps = a better picture, but uses more of the free allowance.
# CLOUDFLARE_IMAGE_STEPS=4
# CLOUDFLARE_CALL_TIMEOUT_MS=50000
# Free services are often "busy" for a minute or two. On your PC, give jobs more tries and
# longer waits (5 tries: 8s, 16s, 32s, 64s):
# JOB_ATTEMPTS=5
# JOB_BACKOFF_MS=8000

# ---- Picture storage (BE-10) ----
# The S3 bucket in the AWS UAE region. Leave empty on your PC: pictures go to STORAGE_DIR.
# S3_BUCKET=
# S3_REGION=me-central-1
# STORAGE_DIR=data/storage
# IMAGE_URL_TTL_SECONDS=3600
# The API's own address, for picture links to the local folder
# API_URL=http://localhost:3000

# ---- Draft review (BE-12) ----
# New pictures one story may ask for (failed ones don't count)
# REDRAWS_PER_STORY=5
# Creator-mode sentence rewriter: longest answer in words, and tries before giving up
# REWRITE_MAX_WORDS=25
# REWRITE_ATTEMPTS=3

# ---- Payments: Stripe Checkout (BE-17) ----
# Test keys only on your PC, dev and staging (a live sk_live_ key is refused outside production).
# Secret key: Stripe dashboard → Developers → API keys. Secret: .env or the AWS secret store only.
STRIPE_SECRET_KEY=
# Webhook signing secret: printed by "stripe listen" on your PC (see docs/stripe-setup.md)
STRIPE_WEBHOOK_SECRET=
# Prices in AED (set by Dina; placeholders for now). Never taken from the browser.
# PRICE_DIGITAL_AED=49
# PRICE_HARDBACK_AED=149
# DELIVERY_HARDBACK_AED=0
# CHECKOUT_EXPIRES_MINUTES=60
# The "Add promotion code" box on Stripe's page (codes are made in the Stripe dashboard)
# PROMO_CODES_ENABLED=true

# ---- Book PDFs (BE-18) ----
# After payment a job makes the book PDF (the parent's download) and, for a hardback, the
# printer's file. Profiles are in src/print/profiles.ts: "generic" (3 mm bleed,
# 12 mm margin, 300 dpi, 8 × 10 in portrait) until the publisher's spec arrives; "digital" = no bleed.
# PRINT_PROFILE=generic
# DOWNLOAD_PROFILE=digital
# BOOK_PDF_TIMEOUT_MS=120000
# Make one again by hand:  pnpm book-pdf <order id or DB-123456> [--save copy.pdf]

# ---- Data deletion (BE-16) ----
# How long database backups are kept (AWS-02 decides); the deletion email states it
# BACKUP_RETENTION_DAYS=35
# While a paid hardback is printing, a deletion waits and checks again this often
# DELETION_PRINT_CHECK_MINUTES=60
