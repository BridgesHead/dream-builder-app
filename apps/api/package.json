{
  "name": "@dream-builder/api",
  "version": "1.0.0",
  "description": "Dream Builder API and job worker",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "seed": "tsx scripts/seed.ts",
    "users": "tsx scripts/users.ts",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "pino": "^10.4.0",
    "rate-limit-redis": "^6.0.2",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dream-builder/api-contracts": "workspace:*",
    "@dream-builder/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
