# Serves the built frontend inside the web container (apps/web/Dockerfile). HTTPS, compression
# and the security headers are added by the front Caddy on the server (infra/server/Caddyfile).
:8080 {
	root * /srv

	# Files under /assets have a content hash in their name, so they never change: cache a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html) is checked again on each visit, so a new deploy shows at once.
	@page not path /assets/*
	header @page Cache-Control "no-cache"

	# The app has its own routes (/parent/dashboard, /story/...): a path that is not a file gets
	# index.html. A missing /assets file stays a 404, never index.html.
	@route {
		not path /assets/*
		not file
	}
	rewrite @route /index.html

	file_server
}
