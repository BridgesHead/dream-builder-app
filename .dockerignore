# Keeps the Docker build context small: only what the API image needs.
.git
.github
.turbo
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example

# The frontend has its own image (apps/web/Dockerfile, with its own ignore file). Its
# package.json stays here so pnpm sees the whole workspace.
apps/web/*
!apps/web/package.json

# Not needed to run the API
Dream-Builder-Generated-Art
infra
netlify.toml
apps/api/data
apps/api/tests
apps/api/legacy
apps/api/docs
