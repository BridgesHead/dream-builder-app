{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Settings every app shares. Each app extends this and adds only its own bits (React for web, Node for api).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  }
}
