{
  "name": "@dream-builder/api-types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from packages/api-contracts/openapi.yaml. Do not edit src/generated by hand.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "openapi-typescript ../api-contracts/openapi.yaml --output src/generated/openapi.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dream-builder/api-contracts": "workspace:*",
    "@dream-builder/config": "workspace:*",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.6.3"
  }
}
